# CẤU HÌNH SUPABASE (NẾU KẾT NỐI ĐÁM MÂY SUPABASE)
# Có thể điền vào đây hoặc điền trực tiếp trong nút "Supabase Cloud" trên giao diện App.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# CẤU HÌNH OMNIROUTER AI (BÁO CÁO TIẾN ĐỘ DOANH NGHIỆP)
# Điền API Key của OmniRouter tại đây hoặc điền trong nút "⚙️ Cài đặt OmniRouter" trên giao diện App.
VITE_OMNIROUTER_API_KEY=your-omnirouter-api-key
VITE_OMNIROUTER_BASE_URL=https://api.omnirouter.ai/v1/chat/completions
VITE_OMNIROUTER_MODEL=antigravity/gemini-3.8-flash-medium
